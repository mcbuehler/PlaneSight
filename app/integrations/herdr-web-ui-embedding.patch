diff --git a/src/lib/embedding.ts b/src/lib/embedding.ts
new file mode 100644
index 0000000..c74fed3
--- /dev/null
+++ b/src/lib/embedding.ts
@@ -0,0 +1,21 @@
+type Parent = Pick<Window, "postMessage">;
+
+/** An embed opts in with an exact origin, never a wildcard or a redirect URL. */
+export function embeddingOrigin(search: string): string | null {
+  const value = new URLSearchParams(search).get("embed_origin");
+  if (!value) return null;
+  try {
+    const url = new URL(value);
+    return ["http:", "https:"].includes(url.protocol) && url.origin === value ? value : null;
+  } catch { return null; }
+}
+
+export function createSentNotifier(search: string, parent: Parent, self: Parent): (machineId: string, paneId: string) => void {
+  const origin = embeddingOrigin(search);
+  return (machineId, paneId) => {
+    if (parent !== self && origin) parent.postMessage({ type: "herdr:message-sent", machineId, paneId }, origin);
+  };
+}
+
+// Capture the opt-in before App removes its initial pane-selection query string.
+export const notifyParentOfSentMessage = typeof window === "undefined" ? () => {} : createSentNotifier(window.location.search, window.parent, window);
diff --git a/src/lib/embedding.test.ts b/src/lib/embedding.test.ts
new file mode 100644
index 0000000..765c87d
--- /dev/null
+++ b/src/lib/embedding.test.ts
@@ -0,0 +1,27 @@
+import { expect, it } from "bun:test";
+import { createSentNotifier, embeddingOrigin } from "./embedding.ts";
+
+it("requires an explicit, exact HTTP(S) parent origin", () => {
+  expect(embeddingOrigin("?embed_origin=http%3A%2F%2F127.0.0.1%3A7777")).toBe("http://127.0.0.1:7777");
+  expect(embeddingOrigin("?embed_origin=https%3A%2F%2Fairport.example")).toBe("https://airport.example");
+  for (const value of ["", "*", "null", "javascript:alert(1)", "https://user:pass@airport.example", "https://airport.example/path", "https://airport.example?x=1"]) {
+    expect(embeddingOrigin(`?embed_origin=${encodeURIComponent(value)}`)).toBeNull();
+  }
+});
+
+it("notifies only the embedding origin with the delivered pane, never the message text", () => {
+  const sent: unknown[][] = [];
+  const parent = { postMessage: (...args: unknown[]) => { sent.push(args); } };
+  const self = { postMessage: () => {} };
+  const notify = createSentNotifier("?embed_origin=http%3A%2F%2F127.0.0.1%3A7777", parent, self);
+  notify("local", "w6:p1");
+  expect(sent).toEqual([[{ type: "herdr:message-sent", machineId: "local", paneId: "w6:p1" }, "http://127.0.0.1:7777"]]);
+});
+
+it("leaves standalone and non-opted-in clients alone", () => {
+  const sent: unknown[][] = [];
+  const parent = { postMessage: (...args: unknown[]) => { sent.push(args); } };
+  createSentNotifier("?embed_origin=http%3A%2F%2F127.0.0.1%3A7777", parent, parent)("local", "w1:p1");
+  createSentNotifier("", parent, { postMessage: () => {} })("local", "w1:p1");
+  expect(sent).toEqual([]);
+});
