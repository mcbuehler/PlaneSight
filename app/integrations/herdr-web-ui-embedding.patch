+/** Explicit HTTP(S) origins only; any invalid entry keeps framing disabled. */
+export function frameAncestors(): string {
+  const values = (process.env["HERDR_WEB_FRAME_ANCESTORS"] ?? "").split(",").map((value) => value.trim()).filter(Boolean);
+  if (!values.length) return "'none'";
+  try {
+    const origins = values.map((value) => {
+      const url = new URL(value);
+      if (!["http:", "https:"].includes(url.protocol) || url.username || url.password || url.pathname !== "/" || url.search || url.hash) throw new Error("Expected an HTTP(S) origin");
+      return url.origin;
+    });
+    return [...new Set(origins)].join(" ");
+  } catch { return "'none'"; }
+}
+
 /**
  * HERDR_WEB_CSP=report-only measures the policy above without enforcing it: the browser
  *   logs what the policy would have blocked and the app keeps working. `report-only` is the
  *   measurement mode; anything else enforces.
