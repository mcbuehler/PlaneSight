{
  "name": "plane-sight",
  "private": true,
  "license": "UNLICENSED",
  "description": "Plane Sight: air traffic control for parallel coding agents in Herdr",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcbuehler/PlaneSight.git"
  },
  "scripts": {
    "setup": "npm --prefix app run setup",
